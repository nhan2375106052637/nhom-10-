# Đổi tên file này thành .env rồi điền API key để trợ lý trả lời bằng LLM.
# Không có key -> trợ lý vẫn chạy ở chế độ offline (tra cứu nội bộ).

# Cách 1: Claude (Anthropic) – lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# Cách 2: API tương thích OpenAI (OpenAI, OpenRouter, Groq, LM Studio/Ollama chạy local...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# PORT=8000
